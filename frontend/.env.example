# =====================================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
# NOTE: Vite only exposes vars prefixed with VITE_.
# Restart `npm run dev` after changing this file.
# =====================================================

# Base URL of the backend API (must include the /api prefix).
# Used by page-view/session tracking, PDF view tracking and all public data fetches.
# In development, point it at your local backend:
VITE_API_BASE_URL=http://localhost:5000/api

# In production, use the public API URL instead, e.g.:
# VITE_API_BASE_URL=https://www.your-domain.com/api
