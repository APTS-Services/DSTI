# =====================================================
# DSTI backend configuration
# Copy to .env and fill in real values. Never commit .env.
# =====================================================

NODE_ENV=development
PORT=5000

# Public origin of the website (used for cookies, sitemap and CORS-free same-origin checks)
PUBLIC_ORIGIN=http://localhost:5173
# Comma-separated list of allowed Host headers (protects against Host-header injection).
# Leave empty in development.
ALLOWED_HOSTS=

# MySQL connection (use a dedicated, least-privilege database user)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dsti_app
DB_PASSWORD="change-me"
DB_NAME=dsti

# Wrap values containing # in double quotes.
# Initial CMS administrator (created by `npm run db:seed` only if no users exist).
# The password must be changed on first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD="Ch@ngeMe#2026"

# Session lifetime
SESSION_IDLE_MINUTES=20
SESSION_ABSOLUTE_HOURS=8

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Feedback notification e-mail (optional). If SMTP_HOST is empty, notifications
# are recorded in the CMS only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dsti.ap.gov.in

# In production, Express serves the built frontend from this folder.
FRONTEND_DIST=../frontend/dist

# Number of trusted reverse proxies in front of the app (for correct client IPs)
TRUST_PROXY=0
