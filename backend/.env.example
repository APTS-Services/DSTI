# =====================================================
# DSTI BACKEND ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in real values.
# =====================================================

# development | production
NODE_ENV=development

# Interface/port the API binds to. Keep HOST=127.0.0.1 when IIS/nginx proxies
# requests to the API on the same machine.
HOST=127.0.0.1
PORT=5000

# Public origin of the website (used for sitemap.xml and absolute links).
PUBLIC_ORIGIN=http://localhost:5173

# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Set to true (or the number of proxy hops, e.g. 1) only when the API is behind
# a trusted reverse proxy such as Nginx or IIS ARR.
TRUST_PROXY=false

# Host names this API answers to (comma separated). Leave empty in development;
# set in production, e.g. dsti.ap.gov.in,www.dsti.ap.gov.in
ALLOWED_HOSTS=

# ---- Database (MySQL 8 / MariaDB 10.6+) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=dsti_website

# ---- Authentication ----
# Generate once: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-hex-secret
JWT_EXPIRES_IN=8h
# CMS sign-in ends after this many idle minutes, and always after SESSION_MAX_HOURS.
SESSION_IDLE_MINUTES=20
SESSION_MAX_HOURS=8

# ---- First CMS administrator (created by `npm run seed` when none exists) ----
# 10-64 characters with upper- and lower-case letters, a digit and a symbol,
# not containing the username. It must be changed at the first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ---- Uploads ----
MAX_UPLOAD_MB=25

# ---- Optional e-mail notifications ----
# When SMTP_HOST is empty, feedback notifications are only written to the log.
SMTP_HOST=
SMTP_PORT=587
# Set to true for implicit TLS (normally only port 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@dsti.ap.gov.in
