<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS + iisnode host for the DSTI API (backend). -->
<configuration>
  <system.webServer>

    <handlers>
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="API Route" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="src/server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Node.js returns its own generic JSON errors; IIS never shows detailed
         error pages (stack traces, physical paths) to remote visitors. -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <iisnode devErrorsEnabled="false" debuggingEnabled="false" loggingEnabled="false" flushResponse="true" />

    <security>
      <requestFiltering removeServerHeader="true" allowDoubleEscaping="false">
        <!-- Never serve source, configuration or secrets. -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment="backups" />
          <add segment="logs" />
        </hiddenSegments>
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="PATCH" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
