<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <handlers>
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="API Route" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="src/server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- DISABLE IIS Error Pages - Pass ALL errors to Node.js -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    
    <!-- DISABLE IIS Request Filtering for Node.js -->
    <iisnode 
      devErrorsEnabled="false"
      flushResponse="true" />

    <!-- REMOVE IIS SERVER HEADER -->
	<security>
		<requestFiltering removeServerHeader="true" />
	</security>

  </system.webServer>
</configuration>